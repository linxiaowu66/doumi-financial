generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  name                 String?
  password             String // 加密后的密码
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  investmentDirections InvestmentDirection[] // 用户的投资方向
  householdMembers     HouseholdMember[]
  householdAssets      HouseholdAsset[]
  insurancePolicies    InsurancePolicy[]
  insurancePlans       InsurancePlan[]
}

// 家庭成员
model HouseholdMember {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  relation  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets            HouseholdAsset[]
  insurancePolicies InsurancePolicy[] @relation("InsuredMember")
  insurancePlans    InsurancePlan[]   @relation("InsurancePlanMember")
  investmentDirections InvestmentDirection[]

  @@index([userId])
}

// 手动维护的家庭资产账户
model HouseholdAsset {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId  Int?
  member    HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  name      String
  platform  String
  balance   Decimal          @default(0) @db.Decimal(15, 2)
  asOfDate  DateTime
  remark    String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  histories HouseholdAssetHistory[]

  @@index([userId])
  @@index([memberId])
}

// 家庭资产余额更新历史
model HouseholdAssetHistory {
  id        Int            @id @default(autoincrement())
  assetId   Int
  asset     HouseholdAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  balance   Decimal        @db.Decimal(15, 2)
  asOfDate  DateTime
  createdAt DateTime       @default(now())

  @@index([assetId])
  @@index([asOfDate])
}

// 家庭保险保障项目
model InsurancePlan {
  id              Int              @id @default(autoincrement())
  userId          Int
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  insuredMemberId Int?
  insuredMember   HouseholdMember? @relation("InsurancePlanMember", fields: [insuredMemberId], references: [id], onDelete: SetNull)
  type            String
  mode            String           @default("LONG_TERM")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  policies        InsurancePolicy[]

  @@index([userId])
  @@index([insuredMemberId])
}

// 家庭保险实际保单
model InsurancePolicy {
  id                  Int              @id @default(autoincrement())
  planId              Int
  plan                InsurancePlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId              Int
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  insuredMemberId     Int?
  insuredMember       HouseholdMember? @relation("InsuredMember", fields: [insuredMemberId], references: [id], onDelete: SetNull)
  name                String
  provider            String?
  policyNumber        String?
  type                String
  coverageAmount      Decimal          @default(0) @db.Decimal(15, 2)
  annualPremium       Decimal          @default(0) @db.Decimal(15, 2)
  startDate           DateTime?
  maturityDate        DateTime?
  refundableAmount    Decimal          @default(0) @db.Decimal(15, 2)
  active              Boolean          @default(true)
  remark              String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  premiumPayments     InsurancePremiumPayment[]

  @@index([userId])
  @@index([planId])
  @@index([insuredMemberId])
}

// 年度保费缴纳记录
model InsurancePremiumPayment {
  id        Int             @id @default(autoincrement())
  policyId  Int
  policy    InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  year      Int
  amount    Decimal         @db.Decimal(15, 2)
  paidAt    DateTime
  remark    String?         @db.Text
  createdAt DateTime        @default(now())

  @@unique([policyId, year])
  @@index([policyId])
}

// 投资方向（海外长钱、稳钱账户、长钱账户等）
model InvestmentDirection {
  id              Int                           @id @default(autoincrement())
  userId          Int? // 所属用户（临时可选）
  user            User?                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdMemberId Int?
  householdMember   HouseholdMember?            @relation(fields: [householdMemberId], references: [id], onDelete: SetNull)
  name            String // 投资方向名称
  type            String                        @default("FUND") // 方向类型：FUND(基金), STOCK(股票)
  expectedAmount  Decimal                       @db.Decimal(15, 2) // 预期投入金额
  actualAmount    Decimal                       @default(0) @db.Decimal(15, 2) // 实际投入金额
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  funds           Fund[] // 该方向下的基金
  categoryTargets CategoryTarget[] // 该方向下的分类目标
  dailyProfits    DirectionDailyProfit[] // 每日盈亏记录
  analyses        InvestmentDirectionAnalysis[] // AI分析历史记录
  householdSnapshots HouseholdDirectionSnapshot[]

  @@index([userId])
  @@index([householdMemberId])
}

// 投资方向在家庭资产中的月度市值快照
model HouseholdDirectionSnapshot {
  id          Int                 @id @default(autoincrement())
  directionId Int
  direction   InvestmentDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)
  month       String              @db.VarChar(7)
  value       Decimal             @db.Decimal(15, 2)
  asOfDate    DateTime
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([directionId, month])
  @@index([directionId])
  @@index([asOfDate])
}

// 基金分类目标仓位（标普、纳指等每个分类的投入上限）
model CategoryTarget {
  id            Int                 @id @default(autoincrement())
  directionId   Int // 所属投资方向
  direction     InvestmentDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)
  categoryName  String // 分类名称（如：标普、纳指、沪深300）
  targetPercent Decimal             @db.Decimal(5, 2) // 目标仓位百分比（0-100）
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([directionId, categoryName])
  @@index([directionId])
}

// 基金
model Fund {
  id               Int                 @id @default(autoincrement())
  directionId      Int // 所属投资方向
  direction        InvestmentDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)
  code             String // 基金代码
  name             String // 基金名称
  category         String? // 分类标识（如"标普"）
  remark           String?             @db.Text // 备注
  latestNetWorth   Decimal?            @db.Decimal(10, 4) // 最新净值
  netWorthDate     String? // 净值日期
  netWorthUpdateAt DateTime? // 净值更新时间

  // 交易配置
  confirmDays           Int     @default(1) // 确认天数：1(境内T+1), 2(QDII T+2)
  defaultBuyFee         Decimal @default(0.15) @db.Decimal(5, 4) // 默认买入费率 % (如0.15)
  defaultSellFee        Decimal @default(0.50) @db.Decimal(5, 4) // 默认卖出费率 % (如0.50)
  dividendReinvest      Boolean @default(false) // 分红方式：false(现金分红)、true(红利再投资)
  alertThreshold        Decimal @default(5.00) @db.Decimal(5, 2) // 涨跌预警比例 %
  takeProfitTrigger     Decimal @default(8.00) @db.Decimal(5, 2) // 止盈观察收益率 %
  takeProfitDrawdown    Decimal @default(3.00) @db.Decimal(5, 2) // 高点回撤止盈比例 %
  takeProfitSellPercent Decimal @default(50.00) @db.Decimal(5, 2) // 建议卖出仓位 %

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  transactions        Transaction[] // 交易记录
  plannedPurchases    PlannedPurchase[] // 计划买入
  pendingTransactions PendingTransaction[] // 待确认交易
  netWorthHistory     FundNetWorthHistory[] // 净值历史
  dailyProfits        FundDailyProfit[] // 每日盈亏记录
}

// 交易记录（买入、卖出、分红）
model Transaction {
  id               Int      @id @default(autoincrement())
  fundId           Int // 所属基金
  fund             Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  type             String // 交易类型：BUY(买入)、SELL(卖出)、DIVIDEND(分红)
  amount           Decimal  @db.Decimal(15, 2) // 交易金额
  shares           Decimal  @db.Decimal(15, 4) // 份额
  price            Decimal  @db.Decimal(10, 4) // 单价/净值
  fee              Decimal  @default(0) @db.Decimal(10, 2) // 手续费
  date             DateTime // 交易日期
  dividendReinvest Boolean  @default(false) // 分红是否再投资（仅分红时有效）
  remark           String?  @db.Text // 备注
  createdAt        DateTime @default(now())

  @@index([fundId])
  @@index([date])
}

// 待确认交易（在支付宝已操作，等待净值确认）
model PendingTransaction {
  id                 Int       @id @default(autoincrement())
  fundId             Int // 所属基金
  fund               Fund      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  type               String // 交易类型：BUY(买入)、SELL(卖出)、DIVIDEND(分红)
  applyDate          DateTime // 申请日期；分红时为发放日
  applyAmount        Decimal?  @db.Decimal(15, 2) // 申请/预计金额
  applyShares        Decimal?  @db.Decimal(15, 4) // 申请份额（卖出时填）
  dividendReinvest   Boolean   @default(false) // 分红是否再投资
  dividendRecordDate DateTime? // 分红权益登记日
  dividendPerShare   Decimal?  @db.Decimal(10, 6) // 每份分红
  sourceKey          String?   @unique // 自动识别来源唯一键，防止重复
  remark             String?   @db.Text
  status             String    @default("WAITING") // 状态：WAITING(等待确认)、CONFIRMED(已确认转正)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([fundId])
  @@index([status])
}

// 计划买入
model PlannedPurchase {
  id            Int       @id @default(autoincrement())
  fundId        Int // 所属基金
  fund          Fund      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  plannedAmount Decimal   @db.Decimal(15, 2) // 计划买入金额
  status        String    @default("PENDING") // 状态：PENDING(待买入)、COMPLETED(已完成)
  createdAt     DateTime  @default(now())
  purchasedAt   DateTime? // 实际买入时间

  @@index([fundId])
  @@index([status])
}

// 节假日/调休配置
model Holiday {
  id     Int      @id @default(autoincrement())
  date   DateTime @unique // 日期
  type   String // 类型：HOLIDAY(节假日，即周一至周五放假), WORKDAY(调休工作日，即周六日上班)
  remark String? // 备注（如：春节、国庆调休）
}

// 投资方向每日盈亏记录
model DirectionDailyProfit {
  id                   Int                 @id @default(autoincrement())
  directionId          Int // 所属投资方向
  direction            InvestmentDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)
  date                 DateTime // 日期（只保留日期部分，时间设为00:00:00）
  dailyProfit          Decimal             @db.Decimal(15, 2) // 每日盈亏金额
  cumulativeProfit     Decimal             @db.Decimal(15, 2) // 累计盈亏金额
  cumulativeProfitRate Decimal             @db.Decimal(10, 4) // 累计收益率（百分比）
  totalInvested        Decimal             @db.Decimal(15, 2) // 累计投入金额
  currentValue         Decimal             @db.Decimal(15, 2) // 当前市值
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([directionId, date])
  @@index([directionId])
  @@index([date])
}

// AI分析历史记录
model InvestmentDirectionAnalysis {
  id          Int                 @id @default(autoincrement())
  directionId Int
  direction   InvestmentDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)
  content     String              @db.LongText
  createdAt   DateTime            @default(now())

  @@index([directionId])
  @@index([createdAt])
}

// 全部投资组合的AI策略分析历史
model PortfolioStrategyAnalysis {
  id        Int      @id @default(autoincrement())
  content   String   @db.LongText
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 年度盈利目标
model AnnualProfitTarget {
  id           Int      @id @default(autoincrement())
  year         Int      @unique
  targetAmount Decimal  @db.Decimal(15, 2)
  actualAmount Decimal? @db.Decimal(15, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 添加在 schema.prisma 最后面

// 基金净值历史记录
model FundNetWorthHistory {
  id        Int      @id @default(autoincrement())
  fundId    Int // 所属基金
  fund      Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  date      String // 净值日期 YYYY-MM-DD
  netWorth  Decimal  @db.Decimal(10, 4) // 净值
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fundId, date])
  @@index([fundId])
  @@index([date])
}

// 基金每日盈亏记录
model FundDailyProfit {
  id                   Int      @id @default(autoincrement())
  fundId               Int
  fund                 Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  date                 String // 净值日期 YYYY-MM-DD
  holdingShares        Decimal  @db.Decimal(18, 6)
  holdingCost          Decimal  @db.Decimal(15, 4)
  holdingValue         Decimal  @db.Decimal(15, 4)
  dailyProfit          Decimal  @db.Decimal(15, 4)
  cumulativeProfit     Decimal  @db.Decimal(15, 4)
  cumulativeProfitRate Decimal  @db.Decimal(10, 6)
  totalInvested        Decimal  @db.Decimal(15, 4)
  isNewHigh            Boolean  @default(false)
  isNewLow             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([fundId, date])
  @@index([fundId])
  @@index([date])
}

// 系统设置（用于存储费率等）
model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @db.Text
  description String? // 描述
  updatedAt   DateTime @updatedAt
}
